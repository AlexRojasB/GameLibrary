# Documentation template only; ASP.NET does not automatically load this file.
# Supply values privately in the dedicated Railway QA service, never the frontend.
# See railway-service-plan.json; this file does not provision or deploy anything.
PORT=10000
RAILWAY_DOCKERFILE_PATH=deploy/qa/Dockerfile
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=60
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=10000
ConnectionStrings__Default=
AllowedOrigins__0=
Authentication__Schemes__Bearer__MetadataAddress=
Authentication__Schemes__Bearer__RequireHttpsMetadata=true
Authentication__Schemes__Bearer__TokenValidationParameters__ValidAudiences__0=authenticated
CoverUploads__Enabled=false
CoverUploads__AllowLocalHttp=false
E2E__Auth__Enabled=false
E2E__CoverUploads__Enabled=false
E2E__CoverImageSearch__Enabled=false
E2E__SteamIntegration__Enabled=false
SteamIntegration__Enabled=false

# For an operator's separate, approved EF migration session only; never Railway/Vercel:
QA_MIGRATION_CONNECTION=

# Deliberately absent: CoverUploads__StorageCredential and StorageBaseUrl.
# Optional external search/Steam secrets are not needed for initial manual QA.
# Railway usage is metered against the existing subscription, not guaranteed free.
