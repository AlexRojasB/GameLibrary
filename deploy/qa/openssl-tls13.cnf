# Private QA API only. Keep client transport at the approved TLS 1.3 boundary.
openssl_conf = openssl_init
config_diagnostics = 1

[openssl_init]
ssl_conf = ssl_configuration

[ssl_configuration]
system_default = tls13_only

[tls13_only]
MinProtocol = TLSv1.3
MaxProtocol = TLSv1.3
CipherString = DEFAULT@SECLEVEL=2
